[Unit]
Description=EpiKairos EPITA Calendar App (Rust backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fernand
WorkingDirectory=/home/fernand/playground/zeus-v2
# Build first with: cargo build --release
ExecStart=/home/fernand/playground/zeus-v2/target/release/epikairos
Restart=always
RestartSec=5
Environment=PORT=5000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
