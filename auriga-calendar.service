[Unit]
Description=Auriga Calendar Web Service for EPITA
After=network.target

[Service]
Type=simple
User=fernand
WorkingDirectory=/home/fernand/playground/zeus-v2
ExecStart=/usr/bin/python3 /home/fernand/playground/zeus-v2/app.py
Restart=always
RestartSec=5
Environment=PORT=5000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
