# Auriga / Epita Credentials
# (Note: You can also leave these blank and the script will prompt you securely)
AURIGA_USERNAME=prenom.nom
AURIGA_PASSWORD=votre_mot_de_passe

# Calendar configuration
CALENDAR_OUTPUT=auriga_planning.ics
CALENDAR_NAME=Auriga - EPITA Emploi du temps
CALENDAR_TIMEZONE=Europe/Paris

# Optional: Specific date range (YYYY-MM-DD). If omitted, defaults to full current academic year.
# CALENDAR_START_DATE=2024-09-01
# CALENDAR_END_DATE=2025-08-31

# -----------------------------------------------------------------------------
# Web server (Rust backend, also read by the Python fallback where noted)
# -----------------------------------------------------------------------------
# PORT=5000
# HOST=0.0.0.0
# SCHOOL_DB_PATH=school.db
# FEEDS_DB_PATH=feeds.db

# Directory holding the generated .flask_secret (sessions) and .server_secret
# (feed credential encryption). Must be persistent, or feeds stop working.
# SECRET_DIR=.

# Optional fixed secrets instead of the generated files.
# SESSION_SECRET_KEY=        (legacy name FLASK_SECRET_KEY is still accepted)
# SERVER_SECRET_KEY=

# Feed cache lifetime in seconds (default 43200 = 12h)
# FEED_CACHE_DURATION=43200

# Behind a reverse proxy
# TRUSTED_PROXY=false
# SESSION_COOKIE_SECURE=false

# Rust only: public host used to build webcal:// links, and accepted Host headers
# SERVER_DOMAIN=calendar.example.com
# ALLOWED_HOSTS=calendar.example.com,192.168.1.50:5000

# Admin accounts (comma-separated Auriga logins, without @epita.fr). Admins open
# /admin to grant the moderator role; moderators publish club calendars in Old Zeus.
# ADMIN_USERS=fernand.huttois
