# -----------------------------------------------------------------------------
# Web server
# -----------------------------------------------------------------------------
# PORT=5000
# HOST=0.0.0.0
# SCHOOL_DB_PATH=school.db
# FEEDS_DB_PATH=feeds.db

# Directory holding the generated .flask_secret (session signing key) and
# .server_secret (feed password encryption). Must be persistent, or feeds stop working.
# SECRET_DIR=.

# Optional fixed secrets instead of the generated files.
# SESSION_SECRET_KEY=        (legacy name FLASK_SECRET_KEY is still accepted)
# SERVER_SECRET_KEY=

# Feed cache lifetime in seconds (default 43200 = 12h)
# FEED_CACHE_DURATION=43200

# Behind a reverse proxy (HTTPS)
# TRUSTED_PROXY=false
# SESSION_COOKIE_SECURE=false

# Optional public host used to build webcal:// links. When neither is set,
# the Host the browser used is reused (e.g. 176.174.155.8:5000).
# SERVER_DOMAIN=calendar.example.com
# ALLOWED_HOSTS=calendar.example.com,192.168.1.50:5000

# Admin accounts (comma-separated Auriga logins, without @epita.fr).
# ADMIN_USERS=fernand.huttois
